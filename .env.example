# Set these as environment variables in Render (this app does not load .env files).
NODE_ENV=production
APP_ORIGIN=https://YOUR-SERVICE.onrender.com
DATA_DIR=/var/data
# Generate a random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUDIT_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Used only on first empty-database startup. Use dedicated public demonstration data.
DEMO_PASSWORD=REPLACE_WITH_A_DEMO_PASSWORD_AT_LEAST_12_CHARACTERS
